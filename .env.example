# Environment Variables Example
# Copy this file to .env and fill in the values

# Application
VITE_APP_NAME=Yalla
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# API Configuration (Future - Backend Integration)
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_API_TIMEOUT=30000

# Authentication (Future - Real Authentication)
# VITE_AUTH_ENABLED=false
# VITE_AUTH_PROVIDER=phone
# VITE_AUTH_SMS_PROVIDER=twilio
# VITE_TWILIO_ACCOUNT_SID=
# VITE_TWILIO_AUTH_TOKEN=
# VITE_TWILIO_PHONE_NUMBER=

# Payment (Future - Real Payment Integration)
# VITE_PAYMENT_ENABLED=false
# VITE_PAYMENT_PROVIDER=stripe
# VITE_STRIPE_PUBLIC_KEY=

# Notifications (Future - Real Notifications)
# VITE_NOTIFICATIONS_ENABLED=false
# VITE_NOTIFICATION_EMAIL_PROVIDER=sendgrid
# VITE_SENDGRID_API_KEY=
# VITE_NOTIFICATION_SMS_PROVIDER=twilio

# Analytics (Future - Privacy-safe Analytics)
# VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_PLAUSIBLE_DOMAIN=

# Error Tracking (Future - Error Monitoring)
# VITE_ERROR_TRACKING_ENABLED=false
# VITE_ERROR_TRACKING_PROVIDER=sentry
# VITE_SENTRY_DSN=

# Feature Flags
VITE_FEATURE_RECOMMENDATIONS=true
VITE_FEATURE_REWARDS=true
VITE_FEATURE_FAVORITES=true
VITE_FEATURE_SHARE=true
VITE_FEATURE_KEYBOARD_SHORTCUTS=true

# Debug
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Security
# VITE_CSRF_ENABLED=false
# VITE_RATE_LIMIT_ENABLED=false
# VITE_RATE_LIMIT_MAX_REQUESTS=100
# VITE_RATE_LIMIT_WINDOW_MS=60000

# Performance
VITE_IMAGE_OPTIMIZATION=true
VITE_LAZY_LOADING=true
VITE_SKELETON_LOADING=true

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,ar

# Cache
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=3600

# Session
VITE_SESSION_TIMEOUT=1800000
VITE_SESSION_WARNING=300000

# NOTE: This is a frontend-only MVP with mock data.
# All backend integrations are simulated.
# For production deployment, implement real backend services.
